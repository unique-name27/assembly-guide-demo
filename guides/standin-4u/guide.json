{
  "v": 1,
  "id": "standin-4u",
  "title": "4U GPU server",
  "builtFor": {
    "sha256": "f83d4da9621f2f2956ea4e149601f6318676474ebdff8385eaa6b66e86f88780",
    "parts": 143
  },
  "meta": {
    "minutes": 50,
    "people": 1,
    "intro": "Work on a clear bench with the lid off. The case arrives with its fans, drive cage, power board and network card already fitted. The drives and the power supplies go in last, from outside. Get a second person to help whenever the case has to be lifted.",
    "tools": {
      "wrist-strap": {
        "name": "Anti-static wrist strap",
        "note": "Clip it to bare metal on the case."
      },
      "ph1": {
        "name": "Phillips screwdriver, size 1, with a torque setting"
      },
      "t30": {
        "name": "Torx T30 screwdriver with a torque setting"
      }
    }
  },
  "callouts": {
    "static": {
      "level": "warning",
      "text": "Static can damage the boards. Put on the wrist strap and clip it to bare metal on the case before you touch any board."
    },
    "socket-pins": {
      "level": "warning",
      "text": "Do not touch the gold pins in the socket or the gold pads under the processor. A bent pin cannot be repaired."
    },
    "no-power-cord": {
      "level": "warning",
      "text": "Do not plug in any power cord yet. Every power supply must be pushed fully in, with its latch clicked, before it gets a cord."
    },
    "screws-loose-first": {
      "level": "caution",
      "text": "Fit all nine screws loosely first. Then tighten them in the same order."
    },
    "heatsink-straight": {
      "level": "caution",
      "text": "Lower each heatsink straight down. Do not slide it about: that smears the paste."
    },
    "cables-flat": {
      "level": "caution",
      "text": "Lay both cables flat on the floor of the case. The GPU board goes in over them later."
    },
    "gpu-board-cables": {
      "level": "caution",
      "text": "Keep the two floor cables flat as the board comes down, so that neither is trapped."
    },
    "gpu-two-hands": {
      "level": "caution",
      "text": "Each GPU module is heavy. Hold it in both hands by the metal bracket and the far edge, never by the cover."
    },
    "drives-straight": {
      "level": "caution",
      "text": "Push each drive in straight and do not force it. If it stops early, pull it out and try again."
    },
    "look-inside": {
      "level": "caution",
      "text": "Look inside before you close the lid: no tools, no loose screws, no cable across an edge."
    },
    "paste-skip": {
      "level": "note",
      "text": "Skip this step if your heatsinks already have a grey pad on the underside."
    },
    "memory-latches": {
      "level": "note",
      "text": "Open both latches of a slot before you push a module in."
    },
    "gpu-ready-built": {
      "level": "note",
      "text": "Each module comes ready built. Do not take it apart."
    }
  },
