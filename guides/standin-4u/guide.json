  "steps": [
    {
      "id": "fit-mainboard",
      "section": "Mainboard",
      "title": "Lower the mainboard onto its nine posts and screw it down",
      "text": "Hold the board by its edges and lower it straight down. Each of the nine posts must show through its hole before any screw goes in.",
      "way": "The two blocks of memory slots run from front to rear, with the two processor sockets side by side between them.",
      "before": [
        "static",
        "screws-loose-first"
      ],
      "tools": [
        "wrist-strap",
        "ph1"
      ],
      "torque": [
        {
          "value": 0.6,
          "unit": "Nm",
          "on": "mainboard-screws"
        }
      ],
      "items": [
        {
          "use": "mainboard",
          "qty": 1
        },
        {
          "use": "mainboard-screws",
          "qty": 9,
          "numbered": true,
          "order": "Start with the middle screw. Then left, right, front and rear. Then the four corners: front left, rear right, rear left, front right."
        }
      ],
      "checks": [
        "All nine posts show through their holes.",
        "The board does not rock.",
        "All nine screws are tightened to 0.6 N·m."
      ]
    },
    {
      "id": "seat-processors",
